# ==========================================
# MeTransfers SaaS — Variables de entorno
# Copia este archivo como .env y rellena los valores
# ==========================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=metransfers
POSTGRES_PASSWORD=cambia_esta_password_fuerte
POSTGRES_DB=metransfers_saas
DATABASE_URL="postgresql://metransfers:cambia_esta_password@localhost:5432/metransfers_saas?schema=public"

# --- pgAdmin (opcional, solo Docker) ---
PGADMIN_DEFAULT_EMAIL=admin@metransfers.com
PGADMIN_DEFAULT_PASSWORD=cambia_esta_password

# --- Autenticación JWT ---
# Genera un valor seguro con: openssl rand -base64 64
# OBLIGATORIO: El servidor crasheará si no existe en producción.
JWT_SECRET=generar_secreto_64_bytes_base64

# --- Usuario admin inicial para prisma/seed.ts ---
ADMIN_EMAIL=admin@metransfers.com
ADMIN_PASSWORD=cambia_esta_password_admin

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000
# Opcional. Por defecto se activa solo si NEXT_PUBLIC_APP_URL usa https:// en producción.
AUTH_COOKIE_SECURE=

# --- Google Maps (obligatorio para cotizaciones/reservas reales) ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- OpenAI Image API (solo servidor) ---
# Nunca publiques esta clave como NEXT_PUBLIC_*. Se usa solo desde rutas server-side.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Rate limit ---
# En producción use database para compartir límites entre contenedores.
RATE_LIMIT_BACKEND=database

# --- Redsys (pasarela de pago España) ---
# Entorno de test: https://sis-t.redsys.es:25443/sis/realizarPago
# Entorno real:    https://sis.redsys.es/sis/realizarPago
REDSYS_URL=https://sis.redsys.es/sis/realizarPago
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
# OBLIGATORIO: El servidor crasheará en producción si falta esta clave.
REDSYS_SECRET_KEY=insert_redsys_key_here

# =====================================================
# SISTEMA DE CORREO AUTOHOSPEDADO
# =====================================================

# hostinger_vps | unrestricted_self_hosted | development
MAIL_INFRA_MODE=hostinger_vps

# Interruptor de seguridad. Debe permanecer false hasta completar DNS y pruebas.
MAIL_SEND_ENABLED=false

MAIL_DOMAIN=transfersinbarcelona.com
MAIL_HOSTNAME=mail.transfersinbarcelona.com
MAIL_PUBLIC_IP=
DKIM_SELECTOR=s1

MAIL_FROM_NAME="Transfers in Barcelona"
MAIL_FROM_TRANSACTIONAL=reservas@transfersinbarcelona.com
MAIL_FROM_MARKETING=novedades@transfersinbarcelona.com
MAIL_REPLY_TO=info@transfersinbarcelona.com
MAIL_BOUNCE_DOMAIN=bounce.transfersinbarcelona.com
MAIL_REPORTS_DOMAIN=reports.transfersinbarcelona.com
MAIL_DEFAULT_TIMEZONE=Europe/Madrid
MAIL_APP_URL=https://transfersinbarcelona.com

# SMTP desde el worker hacia Postfix.
# Modo local Docker: postfix:25
# MTA remoto: mail.transfersinbarcelona.com:2525
SMTP_HOST=postfix
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_AUTH_REQUIRED=false
SMTP_USER=
SMTP_PASS=
SMTP_CA_FILE=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# El worker debe ser una sola réplica mientras el rate limiter sea global.
EMAIL_WORKER_ID=worker-1
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_POLL_MS=1000
EMAIL_LOCK_SECONDS=300
EMAIL_MAX_LOCAL_SUBMIT_ATTEMPTS=6
EMAIL_EVENT_SPOOL=/var/spool/mail-events

# Límites. Modo Hostinger: nunca superar 4/minuto por defecto.
MAIL_GLOBAL_RATE_PER_MINUTE=4
MAIL_MARKETING_RATE_PER_HOUR=180
MAIL_TRANSACTIONAL_RATE_PER_HOUR=240
MAIL_MAX_CAMPAIGN_RATE_PER_HOUR=240
MAIL_MAX_CAMPAIGN_RECIPIENTS=100000

# En modo unrestricted_self_hosted se sigue empezando con bajo volumen.
MAIL_UNRESTRICTED_INITIAL_RATE_PER_HOUR=60
MAIL_UNRESTRICTED_MAX_CONFIGURABLE_RATE_PER_HOUR=5000

# DSN. success genera un evento por cada entrega y aumenta E/S.
# Producción normal: failure,delay
# Pruebas de bajo volumen: success,failure,delay
MAIL_DSN_NOTIFY=failure,delay
MAIL_DSN_SUCCESS_ENABLED=false

# Supresiones y seguridad
MAIL_UNSUBSCRIBE_SECRET=
MAIL_INTERNAL_EVENT_SECRET=
MAIL_DNS_ENFORCE=true
MAIL_REQUIRE_DKIM=true
MAIL_REQUIRE_REVERSE_DNS=true

# Solo cuando Hostinger confirme por escrito un límite superior.
HOSTINGER_CONFIRMED_RATE_PER_MINUTE=5
HOSTINGER_ALLOW_CONFIRMED_OVERRIDE=false

